{
  "name": "dsh-workbench",
  "version": "0.2.2-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:catalog": "node scripts/build-catalog.mjs",
    "verify": "node --check scripts/install-profile.mjs && node --check scripts/smoke-install.mjs && node scripts/build-catalog.mjs && node packages/dsh-role-presets/validate.mjs && node scripts/verify-source.mjs",
    "test:smoke": "node scripts/smoke-install.mjs",
    "build": "npm run build --workspace @dsh-workbench/dsh-message-edit",
    "test": "node scripts/test.mjs",
    "pack:release": "node scripts/pack.mjs"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
