{
  "name": "@dsh-workbench/dsh-workspace-index",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test *.test.*"
  },
  "description": "Local semantic workspace index with incremental updates and search.",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "^4.0.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./remote": "./remote.mjs",
    "./style.css": "./style.css",
    "./embedding.mjs": "./embedding.mjs",
    "./embedding": "./embedding.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.mjs",
    "embedding.mjs",
    "remote.mjs",
    "client.js",
    "style.css",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "license": "AGPL-3.0-only"
}
