{
  "name": "@dsh-workbench/dsh-prompt-enhancer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent prompt enhancement for the conversation composer.",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "^4.0.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./remote": "./remote.mjs",
    "./style.css": "./style.css",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "remote.mjs",
    "client.js",
    "style.css",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "node --test *.test.*"
  }
}
